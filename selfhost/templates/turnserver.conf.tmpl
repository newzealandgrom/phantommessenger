# /etc/turnserver.conf — PHANTOM Messenger TURN relay
# Managed by phantom-selfhost install.sh — правки теряются при повторном запуске установщика.
#
# Аутентификация только эфемерная (TURN REST API): relay подписывает пару
#     username   = "<expiry-unix-ts>:<метка>"
#     credential = base64(HMAC-SHA1(static-auth-secret, username))
# static-auth-secret совпадает с TURN_STATIC_AUTH_SECRET в /etc/phantom-messenger/env.

listening-port=3478
tls-listening-port=5349
min-port=49152
max-port=65535

realm=@@TURN_HOST@@
server-name=@@TURN_HOST@@

lt-cred-mech
use-auth-secret
static-auth-secret=@@TURN_SECRET@@
stale-nonce=600

# Квоты (как на проде; см. RUNBOOK): user-quota считается на TURN-имя — клиент держит под
# одним именем P2P-канал, звонок и ICE-рестарты, поэтому 60. bps-capacity НЕ задавать: он
# резервирует max-bps на каждую сессию и ограничивает сервер (1000000 / 6000000 = 6 аллокаций).
user-quota=60
total-quota=1200
max-bps=1000000
# RFC 6062 TCP relaying WebRTC не нужен и сделал бы сервер универсальным TCP-прокси.
no-tcp-relay

# Во внутренние сети через relay ходить нельзя: метаданные облака, RFC1918, CGNAT, loopback,
# link-local, multicast и IPv6-префиксы, встраивающие IPv4. Собственный публичный IP сервера
# НЕ запрещён намеренно: иначе ломается relay<->relay (два клиента на одном TURN).
no-multicast-peers
no-loopback-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-239.255.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1-::1
denied-peer-ip=::ffff:0:0-::ffff:ffff:ffff
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=100::-100::ffff:ffff:ffff:ffff
denied-peer-ip=2001:db8::-2001:db8:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2002::-2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff

fingerprint
no-cli
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780
prod
log-file=stdout
@@EXTERNAL_IP_LINE@@
